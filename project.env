# Único lugar para ajustar o build (sem mexer nos scripts).
# Butterscotch com suporte a PS4 (PR #647 do projeto ButterscotchRunner), fixado no commit b8c7090.
BUTTERSCOTCH_REPO="https://github.com/TimGoTheCreator/Butterscotch.git"
BUTTERSCOTCH_BRANCH="ps4-support"
BUTTERSCOTCH_REF="b8c7090"
# Argumentos do CMake. Se o log mostrar outro nome de opção, troque só aqui.
CMAKE_ARGS="-DPLATFORM=ps4 -DCMAKE_BUILD_TYPE=Release"
# 1 = compila antes o sample hello_world do OpenOrbis (prova que o toolchain funciona)
RUN_SANITY_SAMPLE=1
